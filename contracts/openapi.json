{
  "openapi": "3.1.0",
  "info": {
    "title": "IDS Phase 7 boundary specification",
    "version": "1.0",
    "description": "Authenticated local inference worker. X-IDS-History-Epoch changes on worker restart or bundle change."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Gateway loopback default"
    }
  ],
  "security": [
    {
      "ServiceCredential": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ServiceCredential": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "status": {
            "const": "error"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "error_code": {
            "enum": [
              "INVALID_INPUT",
              "SCHEMA_MISMATCH",
              "HISTORY_DISCONTINUITY",
              "MODEL_MISMATCH",
              "INVALID_COVERAGE",
              "INSUFFICIENT_HISTORY",
              "MODEL_NOT_READY",
              "OVERLOADED",
              "DEADLINE_EXCEEDED",
              "REQUEST_ID_CONFLICT",
              "PREPROCESS_ERROR",
              "RUNTIME_ERROR",
              "UNAUTHORIZED"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "schema_version",
          "status",
          "request_id",
          "error_code",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/v1/predict": {
      "post": {
        "operationId": "predict",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./v1/FeatureSequence.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok or abstain (score null on abstain)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./v1/InferenceResult.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Explicit failure, no benign fallback. Problem when identity is not trustworthy.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "./v1/InferenceResult.schema.json"
                    },
                    {
                      "$ref": "#/components/schemas/Problem"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Explicit failure, no benign fallback. Problem when identity is not trustworthy.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "./v1/InferenceResult.schema.json"
                    },
                    {
                      "$ref": "#/components/schemas/Problem"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Explicit failure, no benign fallback. Problem when identity is not trustworthy.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "./v1/InferenceResult.schema.json"
                    },
                    {
                      "$ref": "#/components/schemas/Problem"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Explicit failure, no benign fallback. Problem when identity is not trustworthy.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "./v1/InferenceResult.schema.json"
                    },
                    {
                      "$ref": "#/components/schemas/Problem"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Explicit failure, no benign fallback. Problem when identity is not trustworthy.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "./v1/InferenceResult.schema.json"
                    },
                    {
                      "$ref": "#/components/schemas/Problem"
                    }
                  ]
                }
              }
            }
          },
          "504": {
            "description": "Explicit failure, no benign fallback. Problem when identity is not trustworthy.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "./v1/InferenceResult.schema.json"
                    },
                    {
                      "$ref": "#/components/schemas/Problem"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/metadata": {
      "get": {
        "operationId": "metadata",
        "responses": {
          "200": {
            "description": "Loaded bundle identity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "model_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "task": {
                      "const": "attack_associated_traffic"
                    },
                    "feature_schema": {
                      "const": "device_window_v1"
                    },
                    "input_shape": {
                      "const": [
                        1,
                        16,
                        8
                      ]
                    },
                    "preprocess_hash": {
                      "type": "string"
                    },
                    "model_hash": {
                      "type": "string"
                    },
                    "runtime_version": {
                      "type": "string"
                    },
                    "calibration_status": {
                      "const": "uncalibrated"
                    }
                  },
                  "required": [
                    "model_id",
                    "task",
                    "feature_schema",
                    "input_shape",
                    "preprocess_hash",
                    "model_hash",
                    "runtime_version",
                    "calibration_status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Explicit failure, no benign fallback. Problem when identity is not trustworthy.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "./v1/InferenceResult.schema.json"
                    },
                    {
                      "$ref": "#/components/schemas/Problem"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Explicit failure, no benign fallback. Problem when identity is not trustworthy.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "./v1/InferenceResult.schema.json"
                    },
                    {
                      "$ref": "#/components/schemas/Problem"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Readiness and recent errors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ready": {
                      "type": "boolean"
                    },
                    "model_loading": {
                      "type": "boolean"
                    },
                    "recent_errors": {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "ready",
                    "model_loading",
                    "recent_errors"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Explicit failure, no benign fallback. Problem when identity is not trustworthy.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "./v1/InferenceResult.schema.json"
                    },
                    {
                      "$ref": "#/components/schemas/Problem"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
