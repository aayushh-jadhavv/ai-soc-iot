{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-soc.local/contracts/v1/FeatureSequence.schema.json",
  "title": "FeatureSequence",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "windows": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "https://ai-soc.local/contracts/v1/FeatureWindow.schema.json"
      }
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "model_id",
    "windows"
  ],
  "additionalProperties": false
}
